# Ключ из Google AI Studio. Хранится только на сервере, в браузер не попадает.
GEMINI_API_KEY=

# Необязательно: модели и папка базы знаний (значения по умолчанию)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# KNOWLEDGE_DIR=knowledge

# Google Drive как источник базы знаний. Если оба значения заданы, файлы читаются из папки Drive, иначе из knowledge/
# ID папки: часть ссылки после /folders/
# GOOGLE_DRIVE_FOLDER_ID=
# Ключ сервисного аккаунта: либо JSON одной строкой в одинарных кавычках, либо путь к файлу ключа
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
